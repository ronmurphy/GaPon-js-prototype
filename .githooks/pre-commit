#!/bin/sh
# Refuse to commit JavaScript that won't parse.
#
# GaPon is plain <script> tags with no build step, so one bad character takes
# the whole site down: the broken file throws, and every script after it never
# runs, leaving a blank page. A single missing comma in js/data.js did exactly
# that twice in two days, once reaching live GitHub Pages.
#
# Checks the STAGED content (not the working tree), so it validates what you
# are actually committing.
#
# Bypass deliberately with:  git commit --no-verify

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping the JavaScript syntax check."
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$')
[ -z "$staged" ] && exit 0

tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
failed=0

for file in $staged; do
  git show ":$file" > "$tmp/staged.js" 2>/dev/null || continue
  if ! node --check "$tmp/staged.js" 2>"$tmp/err"; then
    [ "$failed" -eq 0 ] && echo ""
    echo "  ✗ $file"
    sed -e "s|$tmp/staged.js|$file|g" -e 's/^/      /' "$tmp/err" | head -4
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo ""
  echo "  Commit blocked — that JavaScript would break the live site."
  echo "  Fix it, or bypass with: git commit --no-verify"
  echo ""
  exit 1
fi

echo "pre-commit: JavaScript parses cleanly ✓"

# Every sticker must have a slot in the trade-code ledger.
#
# Trade codes encode a sticker as its index in TRADE_ID_LEDGER, so a new
# collection that isn't appended there can't be traded — and worse, the
# runtime fallback that keeps it working today reorders itself the next time
# a set is added, silently breaking outstanding codes. Catch it here.

case "$staged" in
  *js/data.js*|*js/tradeids.js*) ;;
  *) exit 0 ;;
esac

git show ":js/data.js"     > "$tmp/data.js"     2>/dev/null || git show HEAD:js/data.js     > "$tmp/data.js"     2>/dev/null
git show ":js/tradeids.js" > "$tmp/tradeids.js" 2>/dev/null || git show HEAD:js/tradeids.js > "$tmp/tradeids.js" 2>/dev/null
[ -s "$tmp/data.js" ] && [ -s "$tmp/tradeids.js" ] || exit 0

missing=$(node -e '
  const fs = require("fs"), dir = process.argv[1];
  eval(fs.readFileSync(dir + "/data.js", "utf8").replace(/^const /gm, "global."));
  eval(fs.readFileSync(dir + "/tradeids.js", "utf8").replace(/^const /gm, "global."));
  const known = new Set(TRADE_ID_LEDGER);
  console.log(Object.keys(ITEMS_BY_ID).filter(id => !known.has(id)).join(" "));
' "$tmp" 2>/dev/null)

if [ -n "$missing" ]; then
  echo ""
  echo "  ✗ js/tradeids.js is missing stickers that exist in js/data.js:"
  echo ""
  for id in $missing; do echo "        '$id',"; done
  echo ""
  echo "  APPEND them to the END of TRADE_ID_LEDGER — never insert or re-sort,"
  echo "  or every unopened trade code in the wild starts decoding wrong."
  echo ""
  echo "  Bypass with: git commit --no-verify"
  echo ""
  exit 1
fi

echo "pre-commit: trade-code ledger covers every sticker ✓"
exit 0
